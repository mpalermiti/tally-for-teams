{
  "name": "streamdeck-teams",
  "version": "0.1.0",
  "description": "Stream Deck plugin for Microsoft Teams meeting controls, via the Teams local third-party app API.",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart ai.michaelp.teams\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node --import tsx scripts/icons.ts",
    "link": "streamdeck link ai.michaelp.teams.sdPlugin",
    "pack": "npm run build && streamdeck pack ai.michaelp.teams.sdPlugin --force",
    "smoke": "node scripts/smoke.mjs",
    "sheet": "node --import tsx scripts/sheet.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@elgato/streamdeck": "^3.0.1"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.1",
    "@resvg/resvg-js": "^2.6.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.19.0",
    "@types/ws": "^8.18.2",
    "lucide-static": "^1.49.0",
    "rollup": "^4.63.5",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2",
    "ws": "^8.22.0"
  },
  "private": true,
  "type": "module"
}
